# Copy to .env (never commit .env). All values below are local-development examples.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when served over HTTPS (secure cookies). Defaults to the inverse of DJANGO_DEBUG.
# DJANGO_SECURE_COOKIES=true

POSTGRES_DB=plantops
POSTGRES_USER=plantops
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Demo environment
PLANTOPS_DEMO_MODE=true
# Password given to the synthetic demo accounts created by `manage.py seed_demo`
PLANTOPS_DEMO_PASSWORD=PlantOps-Demo-2026

PLANTOPS_LOG_LEVEL=INFO
PLANTOPS_ALERT_AUTO_EVALUATE_SECONDS=300
